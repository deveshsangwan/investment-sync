{
  "name": "investment-sync",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "dev:web": "pnpm --filter @investment-sync/web dev",
    "dev:mobile": "pnpm --filter @investment-sync/mobile dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @investment-sync/db generate",
    "db:migrate": "pnpm --filter @investment-sync/db migrate",
    "db:local:up": "docker compose up -d postgres",
    "db:local:down": "docker compose down",
    "db:local:migrate": "DATABASE_URL=postgresql://investment_sync:investment_sync@localhost:54329/investment_sync_dev pnpm --filter @investment-sync/db migrate",
    "db:container:up": "node scripts/local-postgres-container.cjs up",
    "db:container:down": "node scripts/local-postgres-container.cjs down",
    "db:container:logs": "node scripts/local-postgres-container.cjs logs",
    "db:seed:fake": "ALLOW_FAKE_DEV_SEED=1 DATABASE_URL=postgresql://investment_sync:investment_sync@localhost:54329/investment_sync_dev node scripts/seed-fake-dev-data.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^2.1.8"
  }
}
