EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# On a local network, Expo Go replaces localhost with the Metro computer's host.
# For Expo tunnels, set an HTTPS API address reachable from your phone instead.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Optional: same publishable key as NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY.
EXPO_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=
