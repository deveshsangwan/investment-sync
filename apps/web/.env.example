# Required for the converted web pages in development and preview builds.
# Use the exact URL printed by `pnpm dev:backend`, such as
# http://127.0.0.1:3210 locally or https://your-development.convex.cloud.
# Keep development and preview deployments separate from production.
NEXT_PUBLIC_CONVEX_URL=

# Keep unused portfolio query subscriptions live for this many seconds.
# Default: 120. Set 0 to disable. Restart dev or rebuild the preview after edits.
NEXT_PUBLIC_QUERY_CACHE_RETENTION_SECONDS=120
