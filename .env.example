# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
# Required server-only secret for the retained legacy cleanup endpoint.
# Requests must send exactly Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=replace-with-a-random-secret

# Expo
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Copy these public values into apps/mobile/.env.local for Expo.
# Match the web deployment; there is no legacy API fallback.
EXPO_PUBLIC_CONVEX_URL=

# Supabase server-only credentials
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IMPORT_BUCKET=portfolio-imports

# Postgres
DATABASE_URL=
TEST_DATABASE_URL=

# Server-only source write freeze. Unset or false preserves normal behavior.
# Activate only after approval, then drain in-flight requests before a snapshot.
SOURCE_WRITES_PAUSED=false
