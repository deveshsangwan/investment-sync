{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
    },
    "@investment-sync/api#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@investment-sync/db#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@investment-sync/importers#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@investment-sync/analytics#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@investment-sync/mobile#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "env": ["TEST_DATABASE_URL"],
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    }
  }
}
